// Projects data with all images organized by project codes
export interface ProjectImage {
  url: string;
  category?: string;
  nameAr?: string;
}

export interface ProjectSection {
  name: string;
  nameAr: string;
  images: string[];
}

export interface Project {
  id: string;
  title: string;
  titleAr: string;
  image: string;
  category: string;
  description: string;
  descriptionAr: string;
  year?: number;
  sections?: ProjectSection[];
  allImages?: string[];
  coordinates?: { lat: number; lng: number };
}

const BASE_URL = import.meta.env.BASE_URL;
const imagePath = (name: string) => {
  // All images are already in webp format - use as-is
  return `${BASE_URL}images/Project/${name}`;
};

